PORT=3001
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Keep stable across restarts so saved progress can be restored.
SESSION_SECRET=
# Optional PostgreSQL connection URL. Without it, local SQLite is used.
DATABASE_URL=
# Local SQLite path (ignored when DATABASE_URL is set)
SQLITE_PATH=data/synle.db

# Optional Google sign-in. Leave empty to keep guest play available.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No trailing slash. Use https://synle.onrender.com in production.
PUBLIC_URL=http://localhost:5173
